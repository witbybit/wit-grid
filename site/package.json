{
	"name": "wit-grid-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "next dev --webpack --hostname 127.0.0.1 --port 5174",
		"build": "pnpm docs:generate && next build --webpack",
		"start": "next start --hostname 127.0.0.1 --port 5174",
		"docs:generate": "node scripts/generate-docs.mjs",
		"docs:check": "node scripts/generate-docs.mjs --check",
		"docs:lint": "node scripts/lint-docs.mjs",
		"docs:release": "node scripts/release-docs-version.mjs",
		"docs:release:from-package": "node scripts/release-docs-version.mjs --from-package"
	},
	"dependencies": {
		"@eregister/wit-grid-examples": "workspace:*",
		"@eregister/wit-grid-react": "workspace:*",
		"@tailwindcss/postcss": "latest",
		"@types/mdx": "latest",
		"fumadocs-core": "latest",
		"fumadocs-mdx": "latest",
		"fumadocs-ui": "latest",
		"lucide-react": "latest",
		"next": "latest",
		"react": "latest",
		"react-dom": "latest",
		"tailwindcss": "latest",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"postcss": "^8.4.38",
		"shiki": "^4.4.3",
		"ts-morph": "^28.0.0"
	}
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@eregister/open-grid-core": ["./packages/core/src/index.ts"],
			"@eregister/open-grid-core/experimental": ["./packages/core/src/experimental.ts"],
			"@eregister/open-grid-core/internal": ["./packages/core/src/internal.ts"],
			"@eregister/open-grid-react": ["./packages/react/src/index.ts"],
			"@eregister/open-grid-react/experimental": ["./packages/react/src/experimental.ts"]
		},
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedModules": true,
		"jsx": "react-jsx"
	},
	"exclude": ["node_modules", "dist"]
}

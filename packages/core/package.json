{
	"name": "@eregister/open-grid-core",
	"version": "1.4.1",
	"description": "Framework-agnostic high-performance spreadsheet and grid engine core",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./experimental": {
			"types": "./dist/experimental.d.ts",
			"import": "./dist/experimental.js"
		},
		"./internal": {
			"types": "./dist/internal.d.ts",
			"import": "./dist/internal.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "tsc",
		"api:report": "npm run build && node ../../scripts/check-core-api.mjs --write",
		"api:check": "npm run build && node ../../scripts/check-core-api.mjs --check",
		"prepublishOnly": "npm run build",
		"watch": "tsc --watch",
		"typecheck": "tsc --noEmit && node ../../scripts/check-core-test-typecheck.mjs",
		"lint": "eslint src --max-warnings=0",
		"test": "vitest run"
	},
	"keywords": [
		"headless",
		"grid",
		"spreadsheet",
		"table",
		"performance"
	],
	"author": "Rishikesh Kumar",
	"license": "UNLICENSED"
}

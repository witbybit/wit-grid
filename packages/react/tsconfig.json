{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@eregister/open-grid-core": ["../../packages/core/dist/index.d.ts"],
			"@eregister/open-grid-core/experimental": ["../../packages/core/dist/experimental.d.ts"],
			"@eregister/open-grid-core/internal": ["../../packages/core/dist/internal.d.ts"]
		},
		"jsx": "react-jsx",
		"sourceMap": false,
		"declarationMap": false
	},
	"include": ["src/**/*", "css.d.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "dist", "node_modules"]
}
